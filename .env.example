# Copy to .env.local and fill in THERE. This file is committed — it is the
# template that tells anyone cloning the repo which variables to set, so it
# must never contain real values.
#
# .env.local is gitignored, and the repo has secret scanning with push
# protection, so a committed token is rejected at push time.

# From the Sanity project settings. Not secret — it ships in the client bundle.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# SECRET. Only the seeding script needs this; reading published content does
# not. Create it under Project → API → Tokens with Editor permissions.
SANITY_API_WRITE_TOKEN=

# The deployed site's origin (no trailing slash) — canonical URLs, sitemap and
# social-card URLs derive from it. Leave unset locally.
NEXT_PUBLIC_SITE_URL=

# Draft preview (item 18). PREVIEW_SECRET gates /api/draft — share it only via
# the Studio/editor link. On a DEPLOYED site also set SANITY_API_READ_TOKEN to
# a Viewer-scope token so draft reads never carry write power; locally the
# Editor token above covers it.
SANITY_PREVIEW_SECRET=
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity → /api/revalidate webhook (configured in item
# 19 once a deploy URL exists). Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
