# Copy to .env.local and fill in THERE. This file is committed — it is the
# template that tells anyone cloning the repo which variables to set, so it
# must never contain real values.
#
# .env.local is gitignored, and the repo has secret scanning with push
# protection, so a committed token is rejected at push time.

# From the Sanity project settings. Not secret — it ships in the client bundle.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# SECRET. Only the seeding script needs this; reading published content does
# not. Create it under Project → API → Tokens with Editor permissions.
SANITY_API_WRITE_TOKEN=
