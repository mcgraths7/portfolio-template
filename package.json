{
  "name": "portfolio-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.scripts.json",
    "sync:sorbet": "pnpm --dir ${SORBET_DIR:-../sorbet} pack:vendor --to \"$PWD/vendor\" && pnpm install",
    "check:schema": "node scripts/check-schema.ts"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.9.0",
    "@sorbet/component-library": "file:./vendor/sorbet-component-library-0.1.0.tgz",
    "@sorbet/design-system": "file:./vendor/sorbet-design-system-0.1.0.tgz",
    "next": "16.3.0",
    "next-sanity": "^13.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.17.0",
  "description": "A CMS-driven portfolio template built with the Sorbet design system.",
  "engines": {
    "node": ">=24.17.0"
  }
}
